# Persistent Memory MCP
# Copy this file to .env or run: memory-mcp init

# Default local backend
MEMORY_BACKEND=sqlite
SQLITE_PATH=~/.memory-mcp/memory.db

# Use a stable unique identifier. Do not use secrets or passwords.
OWNER_ID=your-stable-local-identifier

# Optional remote backends. Install the corresponding extra first:
#   pip install "persistent-memory-mcp[supabase]"
#   pip install "persistent-memory-mcp[postgresql]"
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# Optional runtime configuration
LOG_LEVEL=INFO
PROJECT_MEMORY_INTERFACE=native

# Recommended privacy defaults
MEMORY_REDACT_SECRETS=true
MEMORY_IGNORE=.env,*.pem,*.key,secrets/**
MEMORY_DEFAULT_RETENTION_DAYS=90
